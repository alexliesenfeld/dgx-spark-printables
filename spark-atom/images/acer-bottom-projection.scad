module acer_bottom_projection(width = 150, depth = 150, thickness = 0.05) {
    pixel_x = width / acer_projection_size;
    pixel_y = depth / acer_projection_size;

    for (rect = acer_projection_rectangles) {
        shade = rect[4] / 255;
        color([shade, shade, shade])
            translate([rect[1] * pixel_x,
                       (acer_projection_size - rect[0] - rect[3]) * pixel_y,
                       -thickness])
                cube([rect[2] * pixel_x + 0.01,
                      rect[3] * pixel_y + 0.01,
                      thickness]);
    }
}
