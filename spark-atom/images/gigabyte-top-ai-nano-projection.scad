    pixel_x = width / gigabyte_top_ai_nano_projection_size;
    pixel_y = depth / gigabyte_top_ai_nano_projection_size;

    for (rect = gigabyte_top_ai_nano_projection_rectangles) {
        shade = rect[4] / 255;
        color([shade, shade, shade])
            translate([rect[1] * pixel_x,
                       (gigabyte_top_ai_nano_projection_size - rect[0] - rect[3]) * pixel_y,
                       -thickness])
                cube([rect[2] * pixel_x + 0.01,
                      rect[3] * pixel_y + 0.01,
                      thickness]);
    }
}
